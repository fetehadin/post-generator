# Copy this file to the server as deploy/.env and fill it in. Never commit the filled-in copy.
# Make passwords with: openssl rand -hex 24  (hex, because base64's / and + break the database URLs)

DOMAIN=voxlace.example.com
# true when another app's Caddy already owns ports 80/443 (deploy/docker-compose.shared-caddy.yml)
SHARED_CADDY=false
# With SHARED_CADDY=true: the other Caddy's Docker network (docker network ls), e.g. otherapp_default
SHARED_NETWORK=

POSTGRES_USER=voxlace
POSTGRES_PASSWORD=
POSTGRES_DB=voxlace
APP_DB_USER=voxlace_app
APP_DB_PASSWORD=

GEMINI_API_KEY=
# Groq second: when Gemini is overloaded it is the one that answers in time. With the 40 s deadline a
# third Gemini model often gets under 10 s and is skipped, so Groq can't wait behind it.
# Check them all with: docker compose ... exec api python -m app.dev check-models
GENERATION_MODELS=google:gemini-flash-latest,groq:openai/gpt-oss-120b,google:gemini-flash-lite-latest
# Groq writes drafts when Gemini is busy (free key at console.groq.com).
GROQ_API_KEY=

# Supabase -> Project settings -> API. The publishable key is public (it is built into the app).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Only if your project signs logins with a shared secret (HS256); cloud projects with signing keys leave it empty.
SUPABASE_JWT_SECRET=
# Where the browser reaches Supabase login. Set it to the site's own address (https://<your domain>)
# when the edge Worker forwards /auth/v1/* (deploy/edge), so networks that block *.supabase.co still
# work. Empty: the browser talks to SUPABASE_URL directly. The API always uses SUPABASE_URL.
AUTH_PUBLIC_URL=
# FR-28: anyone can make an account. INVITE_ONLY=true brings back the invite gate; then the team
# (these emails) joins without an invite code.
INVITE_ONLY=false
ALLOWED_EMAILS=
# FR-47 guest mode. A long random string (openssl rand -hex 32); it signs guests' drafts so they can
# be saved after login. Changing it makes guest drafts not yet saved unsaveable. Empty = guests off.
GUEST_SIGNING_KEY=
GUEST_DAILY_DRAFTS=12
GUEST_DAILY_TOTAL=300

# Off-server copy for deploy/backup.sh: an rsync destination such as user@host:/backups/voxlace
BACKUP_REMOTE=
# Where dumps are kept on the server (14 days); the deploy user must be able to write here.
BACKUP_DIR=/home/deploy/backups/voxlace
