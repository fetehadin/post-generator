{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ruff *)",
      "Bash(pytest *)",
      "Bash(alembic upgrade *)",
      "Bash(alembic revision *)",
      "Bash(alembic current)",
      "Bash(alembic history *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up -d)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(alembic downgrade *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(docker compose down *)",
      "Bash(ssh *)",
      "Edit(./deploy/**)",
      "Write(./deploy/**)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./deploy/.env)",
      "Read(./exports/**)",
      "Read(./uploads/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git reset --hard *)",
      "Bash(docker compose down -v *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_secrets.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
