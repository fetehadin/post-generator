# Copy to .env and fill in. Never commit .env.

# --- Database (local Docker defaults) ---
# Owner/superuser: creates the database and runs migrations. The API never uses it.
POSTGRES_USER=voxlace
POSTGRES_PASSWORD=voxlace
POSTGRES_DB=voxlace
# Limited role the API connects as, so row-level security applies (see docs/OPEN_QUESTIONS.md Q1).
APP_DB_USER=voxlace_app
APP_DB_PASSWORD=voxlace_app
# Host port for the Docker database. Change it if 5432 is taken (e.g. by a local Postgres),
# and change the port in both URLs below to match.
POSTGRES_PORT=5432
# Used by the API.
DATABASE_URL=postgresql+psycopg://voxlace_app:voxlace_app@localhost:5432/voxlace
# Used by Alembic only.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://voxlace:voxlace@localhost:5432/voxlace

# --- AI: embeddings (fixed; changing the model means re-embedding everything) ---
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# --- AI: generation fallback chain, tried in order (provider:model). Check current model names before use. ---
GENERATION_MODELS=google:gemini-flash-latest,google:gemini-flash-lite-latest,groq:llama-3.3-70b-versatile
FALLBACK_API_KEY=

# --- Auth (Phase 2) ---
AUTH_PROVIDER=supabase
SUPABASE_URL=
AUTH_JWKS_URL=
AUTH_JWT_SECRET=

# --- Telegram (Phase 5) ---
TELEGRAM_BOT_TOKEN=

# --- Worker (Phase 5): how often it checks for due posts ---
WORKER_INTERVAL_SECONDS=60

# --- Per-user daily limits (Phase 6) ---
DAILY_DRAFT_LIMIT=30
DAILY_EMBED_LIMIT=2000

# --- App ---
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Production only (deploy/.env on the server) ---
DOMAIN=
BACKUP_REMOTE=
